<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Raw Materials: Prefix '1', padding 6 -->
        <record id="seq_raw_material_lot" model="ir.sequence">
            <field name="name">Raw Material Lot Sequence</field>
            <field name="code">lot.sequence.raw</field>
            <field name="prefix">1</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Sequence for Semi-Finished Goods: Prefix '2', padding 6 -->
        <record id="seq_semi_finished_lot" model="ir.sequence">
            <field name="name">Semi-Finished Lot Sequence</field>
            <field name="code">lot.sequence.semi</field>
            <field name="prefix">2</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Sequence for Finished Goods: Prefix '3', padding 6 -->
        <record id="seq_finished_lot" model="ir.sequence">
            <field name="name">Finished Goods Lot Sequence</field>
            <field name="code">lot.sequence.finished</field>
            <field name="prefix">3</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
<!-- 
DESCRIPTION AND COMMENTS
This XML file defines the two required sequences for our lots:
- 'lot.sequence.raw' has a prefix of '1' and padding of 6, resulting in a format like 1000001.
- 'lot.sequence.finished' has no prefix and padding of 7, resulting in a format like 0000001.
These sequences will be dynamically triggered from Python logic upon lot creation.
-->
